# One canonical origin for the relay, agents, Desktop, Mobile, and NIP-98.
RELAY_URL=wss://your-machine.your-tailnet.ts.net
BUZZ_PUBLIC_WS_URL=wss://your-machine.your-tailnet.ts.net
BUZZ_PUBLIC_HTTP_URL=https://your-machine.your-tailnet.ts.net
BUZZ_PUBLIC_HOST=your-machine.your-tailnet.ts.net
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=replace-with-local-postgres-password
REDIS_PASSWORD=replace-with-local-redis-password
BUZZ_S3_ACCESS_KEY=replace-with-local-minio-access-key
BUZZ_S3_SECRET_KEY=replace-with-local-minio-secret-key
BUZZ_S3_BUCKET=buzz-media
RELAY_OWNER_PUBKEY=replace-with-human-public-key-hex
BUZZ_RELAY_PRIVATE_KEY=replace-with-relay-private-key-hex
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
# For private mobile pairing through Tailscale Serve; replace both labels.
BUZZ_PAIRING_RELAY_URL=wss://your-machine.your-tailnet.ts.net/pair
